{
  "_comment": "Documents every setting and its default. Never put real secrets in a tracked file: use `dotnet user-secrets` locally and environment variables in production (use __ for nesting, e.g. Admin__ApiKey). Sections not listed in appsettings.json fall back to the defaults shown here.",

  "ConnectionStrings": {
    "MasidBahaDb": "Host=<host>;Port=5432;Database=masidbaha;Username=<user>;Password=<password>;SSL Mode=Require"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": false
  },

  "Admin": {
    "ApiKey": "<long random string; sent by the admin panel as the X-Admin-Key header>"
  },
  "Vapid": {
    "PublicKey": "<web push public key>",
    "PrivateKey": "<web push private key>",
    "Subject": "mailto:you@example.com"
  },

  "Security": {
    "SessionSigningKey": "<32+ random characters; signs the anonymous session cookie; required outside Development>",
    "SessionCookieName": "mb_session",
    "SessionCookieSameSite": "Lax",
    "SessionCookieDays": 365,
    "RequireHttps": false,
    "TrustForwardedHeaders": false
  },

  "Reports": { "LifetimeHours": 6, "MaxTopReports": 200 },
  "Expiry": { "SweepIntervalMinutes": 15 },
  "Push": { "MinimumSeverity": "KneeLevel", "QueueCapacity": 100 },
  "Photos": { "MaxUploadBytes": 8388608, "MaxLongestSidePixels": 1600, "JpegQuality": 78 },

  "RateLimits": {
    "ReportWrites": { "PermitLimit": 5, "WindowSeconds": 60 },
    "VoteWrites": { "PermitLimit": 20, "WindowSeconds": 60 },
    "PushWrites": { "PermitLimit": 10, "WindowSeconds": 60 }
  },

  "Geocoding": {
    "BaseAddress": "https://nominatim.openstreetmap.org/",
    "UserAgent": "MasidBaha/1.0 (community flood reporting)",
    "TimeoutSeconds": 5,
    "MinIntervalMilliseconds": 1100,
    "CacheDecimals": 3,
    "CacheMinutes": 1440
  },

  "Storage": {
    "Provider": "Local",
    "S3": {
      "ServiceUrl": "<S3 endpoint, e.g. https://<account>.r2.cloudflarestorage.com>",
      "Bucket": "<bucket name>",
      "AccessKey": "<access key>",
      "SecretKey": "<secret key>",
      "Region": "auto",
      "PublicBaseUrl": "<public URL that serves the bucket, e.g. https://photos.example.com>"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Observability": {
    "OtlpEndpoint": "<optional OpenTelemetry collector, e.g. http://localhost:4317; nothing is exported when unset>"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }
}
