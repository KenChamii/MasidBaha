{
  "name": "masidbaha",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve web",
    "start:admin": "ng serve admin",
    "build": "ng build web && ng build admin",
    "build:shared": "ng build shared",
    "test": "ng test web --watch=false && ng test admin --watch=false && ng test shared --watch=false",
    "watch": "ng build web --watch --configuration development",
    "lint": "ng lint",
    "test:functions": "node --test \"functions-lib/*.test.mjs\"",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,json}\"",
    "prepare": "cd .. && husky frontend/.husky",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@microsoft/signalr": "^10.0.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "projects/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "projects/**/*.{scss,json}": [
      "prettier --write"
    ]
  }
}
